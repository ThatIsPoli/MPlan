<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <!-- Appender per la Console (pag. 5 della dispensa) -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- Imposta il livello su INFO (invece che solo ERROR) per i pacchetti del nostro progetto -->
        <Logger name="it.mpelettrica.mplan" level="info" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
        </Logger>

        <Root level="error">
            <AppenderRef ref="ConsoleAppender"/>
        </Root>
    </Loggers>
</Configuration>