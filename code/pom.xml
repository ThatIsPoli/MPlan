<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>it.mpelettrica.mplan</groupId>
    <artifactId>mplan-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MPlan - Project Parent</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>27</maven.compiler.release>
        <log4j.version>2.26.1</log4j.version>
        <junit.jupiter.version>5.11.0</junit.jupiter.version>
        <sqlite.version>3.46.1.0</sqlite.version>
        <jooq.version>3.19.11</jooq.version>
    </properties>

    <!-- Elenco dei 5 moduli previsti dal Design -->
    <modules>
        <module>mplan-api</module>
        <module>mplan-core</module>
        <module>mplan-persistence</module>
        <module>mplan-ui-swing</module>
        <module>mplan-app</module>
    </modules>

    <!-- Gestione centralizzata delle versioni -->
    <dependencyManagement>
        <dependencies>
            <!-- Moduli interni del progetto -->
            <dependency>
                <groupId>it.mpelettrica.mplan</groupId>
                <artifactId>mplan-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>it.mpelettrica.mplan</groupId>
                <artifactId>mplan-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>it.mpelettrica.mplan</groupId>
                <artifactId>mplan-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>it.mpelettrica.mplan</groupId>
                <artifactId>mplan-ui-swing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>it.mpelettrica.mplan</groupId>
                <artifactId>mplan-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Logging: Log4j 2.26.1 (dispensa e VIN.4) -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>

            <!-- Database: SQLite e jOOQ (Design 2.3) -->
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jooq</groupId>
                <artifactId>jooq</artifactId>
                <version>${jooq.version}</version>
            </dependency>

            <!-- Testing: JUnit 5 (VIN.5) -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>27</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>